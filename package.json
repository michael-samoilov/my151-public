{
  "name": "my151",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cache-sprites": "bash scripts/cache-sprites.sh",
    "sprites:measure": "node scripts/build-favorite-sprite-ink.mjs",
    "build-type-glyphs": "tsx scripts/build-type-glyphs.ts",
    "league:forms": "node --import tsx scripts/league/build-form-names.ts",
    "league:powerups": "tsx --tsconfig tsconfig.node.json scripts/league/fetch-powerup-forms.ts",
    "shade-report": "tsx --tsconfig tsconfig.node.json scripts/shade-report.ts",
    "og-image": "node scripts/generate-og-image.mjs",
    "indexnow": "NODE_USE_ENV_PROXY=1 node scripts/indexnow.mjs",
    "search:connect-google": "node scripts/connect-google-search-console.mjs",
    "prebuild": "node --import tsx scripts/ci/typecheck-state.ts",
    "build": "npm run i18n:verify && tsc -b && vite build",
    "build:vercel": "tsc -b --clean && npm run build && tsx scripts/keep-previous-assets.ts dist",
    "lint": "eslint . --suppressions-location eslint-suppressions.json",
    "preview": "vite preview",
    "doctor": "npx react-doctor@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:data": "tsx scripts/i18n/build-data-catalog.ts",
    "i18n:tiers": "tsx scripts/i18n/report-tiers.ts",
    "i18n:propose-map": "tsx scripts/i18n/propose-id-map.ts",
    "i18n:names": "tsx scripts/i18n/build-name-catalogs.ts",
    "i18n:fixture": "tsx scripts/i18n/build-id-map-fixture.ts",
    "i18n:terms": "tsx scripts/i18n/build-term-catalogs.ts",
    "i18n:game-text": "tsx scripts/i18n/fetch-game-text.ts",
    "i18n:game-terms": "tsx scripts/i18n/extract-game-terms.ts",
    "i18n:verify": "tsx scripts/i18n/verify.ts",
    "i18n:extract": "tsx scripts/i18n/translate/extract.ts",
    "favorites:browser-ids": "tsx --tsconfig tsconfig.node.json scripts/build-favorite-browser-ids.ts",
    "credits:bundles": "tsx scripts/credits/bundle-credits.ts",
    "credits:check-sprites": "tsx scripts/credits/check-sprite-evidence.ts && tsx scripts/credits/bundle-credits.ts --check",
    "ontology:check": "tsx scripts/ontology/build.ts",
    "ontology:build": "tsx scripts/ontology/build.ts --write",
    "ontology:extract": "tsx scripts/ontology/pokeapi/extract.ts",
    "ontology:audit": "tsx scripts/ontology/audit.ts",
    "ontology:parity": "vitest run scripts/ontology/parity.test.ts",
    "type-icons:glyph-paths": "tsx --tsconfig tsconfig.node.json scripts/build-type-glyph-paths.ts",
    "ci": "node --import tsx scripts/ci/run.ts affected",
    "ci:fast": "node --import tsx scripts/ci/run.ts fast",
    "ci:affected": "node --import tsx scripts/ci/run.ts affected",
    "ci:full": "node --import tsx scripts/ci/run.ts full",
    "ci:pre-push": "node --import tsx scripts/ci/pre-push.ts",
    "release:smoke": "node --import tsx scripts/release/smoke.ts smoke",
    "release:live": "node --import tsx scripts/release/smoke.ts live"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "d3-scale": "^4.0.2",
    "echarts": "6.1.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pinyin-pro": "^3.28.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  }
}
