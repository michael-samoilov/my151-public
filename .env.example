# Environment variables that my151 reads. Every value is empty on purpose.
# The browser tools need none of them. Copy this file to .env.local only for
# the variables you need, and never commit real values.

# --- Vercel functions in api/ -------------------------------------------------

# Upstash Redis REST endpoint where the functions store usage records.
UPSTASH_REDIS_REST_URL=
# Token for the Upstash Redis REST endpoint.
UPSTASH_REDIS_REST_TOKEN=
# Token that unlocks the admin reports at /?admin.
ADMIN_TOKEN=
# Secret that Vercel Cron sends to /api/retention, the daily data cleanup.
CRON_SECRET=
# Optional: Upstash management account email, for the storage usage line in admin.
UPSTASH_MGMT_EMAIL=
# Optional: Upstash management API key, for the same usage line.
UPSTASH_MGMT_API_KEY=
# Optional: Upstash database ID, for the same usage line.
UPSTASH_DB_ID=
# Optional: Search Console property, such as sc-domain:example.com, for the search tab.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Optional: service-account JSON with read access to that property.
GOOGLE_SEARCH_SERVICE_ACCOUNT_JSON=
# Optional: OAuth client ID, used instead of a service account.
GOOGLE_SEARCH_CLIENT_ID=
# Optional: OAuth client secret for that client.
GOOGLE_SEARCH_CLIENT_SECRET=
# Optional: OAuth refresh token for that client.
GOOGLE_SEARCH_REFRESH_TOKEN=
# Optional: Bing Webmaster Tools API key, for Bing rows in the search tab.
BING_WEBMASTER_API_KEY=
# Optional: site URL registered in Bing Webmaster Tools.
BING_WEBMASTER_SITE_URL=
# Optional: 0 turns off the minute-by-minute activity history.
MINUTE_ACTIVITY_ENABLED=
# Optional: monthly cap on Redis commands for that history.
MINUTE_ACTIVITY_MONTHLY_UNITS=
# Optional: monthly cap on bytes stored for that history.
MINUTE_ACTIVITY_MONTHLY_BYTES=

# --- Set by Vercel; read by the functions and the build ------------------------

# production, preview, or development. Preview builds turn on preview features.
VERCEL_ENV=
# Production domain, used to copy the previous deploy's assets.
VERCEL_PROJECT_PRODUCTION_URL=
# Commit message, read by the Ignored Build Step.
VERCEL_GIT_COMMIT_MESSAGE=
# Branch name, read by the Ignored Build Step.
VERCEL_GIT_COMMIT_REF=
# Commit being built, read by the Ignored Build Step.
VERCEL_GIT_COMMIT_SHA=
# Previous deployed commit, read by the Ignored Build Step.
VERCEL_GIT_PREVIOUS_SHA=

# --- Build ---------------------------------------------------------------------

# Seconds since 1970 to stamp a reproducible build time.
SOURCE_DATE_EPOCH=
# Site whose /assets files a production build keeps, for tabs opened before a deploy.
KEEP_ASSETS_FROM=
# 1 builds the homepage artwork capture page.
MY151_HOME_ARTWORK_CAPTURE=

# --- Local CI and browser tests -----------------------------------------------

# Git ref that selects changed files. Default: the production branch, else origin/main, else main.
MY151_CI_BASE=
# Number of Playwright workers for the CI runner. Default: 2.
MY151_CI_WORKERS=
# Set by the CI runner: the run's evidence folder.
MY151_CI_RUN_DIR=
# Set by the CI runner: the run's ID.
MY151_CI_RUN_ID=
# Set by the CI runner with --record-map: where specs write the files they ran.
MY151_TEST_MAP_DIR=
# Set by the CI runner with --record-map: the build those specs ran.
MY151_TEST_MAP_DIST=
# Set by a tool that already holds the shared browser lock.
MY151_BROWSER_LOCK=
# Run the browser suite against this URL instead of local servers.
PLAYWRIGHT_BASE_URL=
# Port of the local preview server. Default: derived from the worktree path.
PLAYWRIGHT_PREVIEW_PORT=
# Port of the local development server. Default: derived from the worktree path.
PLAYWRIGHT_DEV_PORT=
# Folder that holds the Playwright browsers.
PLAYWRIGHT_BROWSERS_PATH=
# Chromium binary for the sprite-ink and art-capture scripts.
PLAYWRIGHT_CHROMIUM_PATH=
# Chromium binary for the release smoke test and the artwork bake.
CHROMIUM_PATH=

# --- verify-my151 harness ------------------------------------------------------

# Folder of the Gecko and WebKit engines. Default: /opt/verify-my151.
VERIFY_ENGINE_DIR=
# Blink driver to force: agent-browser or playwright.
VERIFY_BLINK_DRIVER=
# agent-browser binary to use.
VERIFY_AGENT_BROWSER_BIN=
# Firefox binary for the Gecko engine.
VERIFY_FIREFOX_BIN=
# WebKit browser binary.
VERIFY_WEBKIT_BROWSER=
# WebKit WebDriver binary.
VERIFY_WEBKIT_DRIVER=

# --- Other tools -----------------------------------------------------------------

# Google API key restricted to PageSpeed Insights, for scripts/performance/psi.mjs.
PAGESPEED_API_KEY=
# Extra comma-separated SHA-256 hashes of addresses that the email-guard hook asks about.
MY151_GUARD_EXTRA_SHA256=
# Set by scripts/home-artwork/refresh.mjs when it holds the browser lock.
MY151_HOME_ARTWORK_LOCKED=
# Set by scripts/home-artwork/refresh.mjs: the run's output folder.
MY151_HOME_ARTWORK_RUN=
# Base URL that scripts/capture-tool-art.mjs opens.
ART_BASE_URL=
# Output folder for scripts/capture-tool-art.mjs.
ART_CAPTURE_DIR=
# Output folder for scripts/generate-og-image.mjs images.
OG_OUT_DIR=
# Output folder for scripts/generate-og-image.mjs HTML.
OG_HTML_OUT_DIR=
# Gap between the parts of a compound type icon. Default: 1.3.
TYPE_ICON_GAP=
# Python binary for the type-icon scripts. Default: python.
TYPE_ICON_PYTHON=
# Folder that holds redis-server and redis-cli for scripts/security-review.sh.
SECURITY_REDIS_RUNTIME=
# Source folder that the security access test reads.
SECURITY_SOURCE_ROOT=
# Phase label for the security access evidence.
SECURITY_EVIDENCE_PHASE=
# Output folder for the security access evidence.
SECURITY_ACCESS_EVIDENCE_DIR=
