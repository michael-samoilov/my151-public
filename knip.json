    "scripts/capture-tool-art.mjs",
    "scripts/favorite-minimap-spot.ts",
    "scripts/fetch-favorite-picker-sprites.ts",
    "scripts/gen-chains.mjs",
    "scripts/generate-data.cjs",
    "scripts/i18n/extract-picker-form-text.ts",
    "scripts/i18n/report-picker-name-coverage.ts",
    "scripts/intro-stages.mjs",
    "scripts/league/fetch-moves.ts",
    "scripts/level-model-report.ts",
    "scripts/ontology/build.ts",
    "scripts/measure-badge-art.ts",
