{
  "buildCommand": "npm run build:vercel",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sprites/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/favorite-pokemon-by-type",
      "destination": "/favorite-pokemon-picker",
      "permanent": true
    },
    {
      "source": "/favorite-pokemon-by-type.html",
      "destination": "/favorite-pokemon-picker",
      "permanent": true
    },
    {
      "source": "/gym-leader-maker",
      "destination": "/custom-gym-leader",
      "permanent": true
    },
    {
      "source": "/gym-leader",
      "destination": "/custom-gym-leader",
      "permanent": true
    },
    {
      "source": "/league-maker",
      "destination": "/custom-gym-leader",
      "permanent": true
    },
    {
      "source": "/trainer-card-maker",
      "destination": "/custom-gym-leader",
      "permanent": true
    },
    {
      "source": "/pokedex-maker",
      "destination": "/pokedex-builder",
      "permanent": true
    },
    {
      "source": "/custom-pokedex",
      "destination": "/pokedex-builder",
      "permanent": true
    },
    {
      "source": "/favorite-pokemon",
      "destination": "/favorite-pokemon-picker",
      "permanent": true
    }
  ]
}
